# Домен сайта (A-запись должна указывать на сервер). Caddy сам получит HTTPS-сертификат.
DOMAIN=kpp.hta.kz
PUBLIC_URL=https://kpp.hta.kz

# Длинные случайные строки, например: openssl rand -hex 32
# Без SECRET_KEY (не короче 32 символов) API не запустится. Смена SECRET_KEY выкидывает всех из системы.
POSTGRES_PASSWORD=
SECRET_KEY=

# Telegram-бот: создать у @BotFather, токен и имя без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Отчёт за день (Ф-19)
REPORT_TIME=16:50
# Почта для отчёта, через запятую (необязательно)
REPORT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Только для проверки без HTTPS на своём компьютере: COOKIE_SECURE=0
COOKIE_SECURE=1

# Прямой доступ к API: по умолчанию только этот компьютер.
# Для тестового стенда в локальной сети: API_BIND=0.0.0.0, API_PORT=8090, COOKIE_SECURE=0
API_BIND=127.0.0.1
API_PORT=8000

# От кого верить заголовку X-Forwarded-For (настоящий IP для лимита попыток входа).
# Основной сервер + внешний сервер через WireGuard: FORWARDED_ALLOW_IPS=10.77.0.1 (deploy/edge/README.md)
# Пусто — верить всем (только если API закрыт от сети за Caddy)
FORWARDED_ALLOW_IPS=
