# Домен сайта (A-запись должна указывать на сервер). Caddy сам получит HTTPS-сертификат.
DOMAIN=kpp.hta.kz
PUBLIC_URL=https://kpp.hta.kz

# Длинные случайные строки, например: openssl rand -hex 32
# Без SECRET_KEY (не короче 32 символов) API не запустится. Смена SECRET_KEY выкидывает всех из системы.
POSTGRES_PASSWORD=
SECRET_KEY=

# Telegram-бот: создать у @BotFather, токен и имя без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Отчёт за день (Ф-19)
REPORT_TIME=16:50
# Почта для отчёта, через запятую (необязательно)
REPORT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Только для проверки без HTTPS на своём компьютере: COOKIE_SECURE=0
COOKIE_SECURE=1

# Прямой доступ к API: по умолчанию только этот компьютер.
# Для тестового стенда в локальной сети: API_BIND=0.0.0.0, API_PORT=8090, COOKIE_SECURE=0
API_BIND=127.0.0.1
API_PORT=8000

# ---------- Пилот Hikvision (docs/hikvision/MVP_IMPLEMENTATION.md) ----------
# SIMULATION — только виртуальные терминалы (по умолчанию); READ_ONLY — только чтение с терминалов;
# PILOT — ответ success может уйти на терминалы из HIKVISION_CONTROL_DEVICES при HIKVISION_CONTROL_ENABLED=1.
# Включение PILOT и управления — только после отдельного письменного разрешения (PILOT_TEST_PLAN.md).
HIKVISION_MODE=SIMULATION
HIKVISION_CONTROL_ENABLED=0
HIKVISION_CONTROL_DEVICES=
HIKVISION_PILOT_EMPLOYEE_NOS=3818077855
HIKVISION_DECISION_BUDGET_MS=1500
HIKVISION_MAX_EVENT_AGE_S=60
HIKVISION_ALLOWED_MINORS=75
HIKVISION_PASSAGE_WINDOW_S=30
# Только эти userType должны приходить на удалённую проверку; запрос от другого = нарушение изоляции → DENY
HIKVISION_REMOTE_CHECK_USER_TYPES=visitor
# Смена userType ОДНОЙ записи пилота (UserInfo/Modify) — отдельно от управления проходом; только после подтверждения
HIKVISION_USER_WRITE_ENABLED=0
HIKVISION_USER_WRITE_DEVICES=
# Учётные данные терминала: HIK_<credentials-env>_USER / HIK_<credentials-env>_PASSWORD
# HIK_STAND_USER=
# HIK_STAND_PASSWORD=
# Приёмник терминалов слушает только сеть терминалов (не через Caddy)
HIKVISION_GATEWAY_BIND=127.0.0.1
HIKVISION_GATEWAY_PORT=8090

# От кого верить заголовку X-Forwarded-For (настоящий IP для лимита попыток входа).
# Основной сервер + внешний сервер через WireGuard: FORWARDED_ALLOW_IPS=10.77.0.1 (deploy/edge/README.md)
# Пусто — верить всем (только если API закрыт от сети за Caddy)
FORWARDED_ALLOW_IPS=
